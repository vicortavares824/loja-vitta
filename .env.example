# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Cloudinary Configuration (Image Upload)
# Get these from: https://console.cloudinary.com → Settings → Upload
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset_here

# Admin Configuration (used server-side only via Supabase RPC)
# Do NOT prefix with VITE_ as it should not be exposed to the client
ADMIN_SECRET_KEY=your_admin_secret_key_here

# =============================================================================
# Mercado Pago (public key - safe for the browser)
# =============================================================================
VITE_MERCADOPAGO_PUBLIC_KEY=APP_USR-your-public-key-here

# =============================================================================
# SERVER-ONLY variables (api/ serverless functions)
# Configure in: Vercel > Settings > Environment Variables
# NEVER use the VITE_ prefix here: VITE_ variables are bundled into the client.
# Locally, never put real secrets in this file; use .env (git-ignored).
# =============================================================================

# Supabase URL used by the server (no VITE_ prefix)
SUPABASE_URL=https://your-project.supabase.co

# Supabase service role key. Bypasses RLS. It must NEVER have a VITE_ prefix
# and must never reach the client.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Mercado Pago server credentials
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-access-token-here
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret_here

# Public site URL (used for redirects and webhook URLs)
SITE_URL=https://your-site.example.com

# Secret that authorizes the cron route (expired order cleanup)
CRON_SECRET=your_cron_secret_here

# Pix expiration in minutes (1-1440, default: 30)
PIX_EXPIRATION_MINUTES=30
